# Per-platform API base URLs (see apiClient.js + .env.example):
#   WEB   → browser / PWA builds
#   MOBILE → Capacitor native builds (the phone/emulator needs the LAN IP of
#            the machine running the backend, because "localhost" on a device
#            is the device itself)
VITE_API_BASE_URL_WEB=https://localhost:7282
VITE_API_BASE_URL_MOBILE=https://localhost:7282

# Shared fallback when only one address is defined
VITE_API_BASE_URL=https://localhost:7282

# optional: request timeout in ms (default 90000; uploads/pipeline use no timeout)
VITE_API_TIMEOUT_MS=90000

# For LAN testing on a physical device, point MOBILE at your machine, e.g.:
# VITE_API_BASE_URL_MOBILE=https://192.168.1.35:7282
